    "node_classification_direct_max": 100000,
    "node_classification_target_chunk": 100000,
    "seg_positive_edge_thresh": 0.55,
    "seg_leiden_resolution": 0.1,
    "seg_num_edges_perSpot": 30,
    "seg_graph_n_neighbors": 10,
    "ann_min_transcripts": 20,
    "ann_min_dominant_nodes": 10,
    "ann_min_dominant_ratio": 0.4
